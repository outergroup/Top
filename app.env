APP_ID="org.outershell.Top"
APP_NAME="Top"
APP_STAGE_NAME="Top"
XCODE_PROJECT="Top.xcodeproj"
XCODE_SCHEME="Top"
XCODE_PRODUCT_NAME="Top"
BUNDLE_ARCHIVE_SCRIPT="Scripts/archive_top_bundle.sh"
BUNDLE_ARCHIVE_STEM="TopContent.bundle"
BACKEND_SOURCE="Backend/main.c"
BACKEND_EXECUTABLE_NAME="TopBackend"
BACKEND_CFLAGS="-std=gnu17 -O2 -fno-omit-frame-pointer -fno-optimize-sibling-calls -ffunction-sections -fdata-sections"
BACKEND_LDFLAGS="-ldl -lpthread -lm"
DEFAULT_DEPLOY_SCOPE="user"
ROOT_ONLY="false"
